// ============================================================
// Jenkinsfile — Pipeline do Backend (Spring Boot)
// Repositório: d:\GIT\Projeto _Loja_3D\ecommerce-api
// Trigger: Manual / Push
// ============================================================
pipeline {
    agent any

    // Variáveis sensíveis gerenciadas pelo Jenkins Credentials
    environment {
        // Banco de Dados & Configurações do Back-end
        DB_URL                    = credentials('LOJA_DB_URL')
        DB_USERNAME               = credentials('LOJA_DB_USERNAME')
        DB_PASSWORD               = credentials('LOJA_DB_PASSWORD')
        CRYPT_SECRET_KEY          = credentials('LOJA_CRYPT_SECRET_KEY')
        ADMIN_FIRST_EMAIL         = credentials('LOJA_ADMIN_FIRST_EMAIL')
        MELHOR_ENVIO_API_URL      = credentials('LOJA_MELHOR_ENVIO_API_URL')
        MELHOR_ENVIO_TOKEN        = credentials('LOJA_MELHOR_ENVIO_TOKEN')
        MERCADO_PAGO_PUBLIC_KEY   = credentials('LOJA_MERCADO_PAGO_PUBLIC_KEY')
        MERCADO_PAGO_ACCESS_TOKEN = credentials('LOJA_MERCADO_PAGO_ACCESS_TOKEN')

        // CEP de origem fixo da loja
        MELHOR_ENVIO_CEP_ORIGEM   = '09894280'

        // Docker
        DOCKER_IMAGE     = 'patrickmoura/ecommerce-api'
        CONTAINER_NAME   = '3dprintpng-api'
        APP_PORT         = '8088'
        UPLOADS_HOST_DIR = '/app/uploads'
    }

    stages {
        stage('Checkout') {
            steps {
                echo '=== Clonando repositorio ==='
                checkout scm
            }
        }

        stage('Extrair Versao do POM') {
            steps {
                echo '=== Detectando versao da aplicacao a partir do pom.xml ==='
                dir('ecommerce-api') {
                    script {
                        def pomVer = sh(
                            script: 'mvn help:evaluate -Dexpression=project.version -q -DforceStdout 2>/dev/null || grep -m 1 "<version>" pom.xml | sed -E "s/.*<version>([^<]+)<\\/version>.*/\\1/" | tr -d " \t\r\n"',
                            returnStdout: true
                        ).trim()
                        if (!pomVer || pomVer.contains('[INFO]') || pomVer.contains('null')) {
                            pomVer = '1.0.0'
                        }
                        env.APP_VERSION = pomVer
                        echo "Versao definida para o release do Backend: ${env.APP_VERSION}"
                    }
                }
            }
        }

        stage('Build Maven') {
            steps {
                echo '=== Compilando e empacotando o Backend ==='
                dir('ecommerce-api') {
                    sh '''
                        export JAVA_HOME=/usr/lib/jvm/zulu25
                        export PATH=$JAVA_HOME/bin:$PATH
                        java -version
                        mvn clean package -DskipTests --no-transfer-progress
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                echo "=== Construindo imagem Docker do Backend (Versao: ${env.APP_VERSION}, Build: #${BUILD_NUMBER}) ==="
                dir('ecommerce-api') {
                    sh '''
                        docker build \
                            --build-arg JAR_FILE=target/*.jar \
                            -t ${DOCKER_IMAGE}:${APP_VERSION} \
                            -t ${DOCKER_IMAGE}:${APP_VERSION}-${BUILD_NUMBER} \
                            -t ${DOCKER_IMAGE}:latest \
                            .
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                echo "=== Parando container antigo e subindo novo com versao ${env.APP_VERSION} ==="
                sh '''
                    # Para e remove o container anterior (se existir)
                    docker stop ${CONTAINER_NAME} || true
                    docker rm   ${CONTAINER_NAME} || true

                    # Sobe o novo container conectado a rede do Jenkins (jenkins_jenkins_net)
                    docker run \
                        --name ${CONTAINER_NAME} \
                        --network jenkins_jenkins_net \
                        --restart=always \
                        -d \
                        -p ${APP_PORT}:${APP_PORT} \
                        -e SPRING_PROFILES_ACTIVE=dev \
                        -e DB_URL="${DB_URL}" \
                        -e DB_USERNAME="${DB_USERNAME}" \
                        -e DB_PASSWORD="${DB_PASSWORD}" \
                        -e CRYPT_SECRET_KEY="${CRYPT_SECRET_KEY}" \
                        -e ADMIN_FIRST_EMAIL="${ADMIN_FIRST_EMAIL}" \
                        -e MELHOR_ENVIO_API_URL="${MELHOR_ENVIO_API_URL}" \
                        -e MELHOR_ENVIO_CEP_ORIGEM="${MELHOR_ENVIO_CEP_ORIGEM}" \
                        -e MELHOR_ENVIO_TOKEN="${MELHOR_ENVIO_TOKEN}" \
                        -e MERCADO_PAGO_PUBLIC_KEY="${MERCADO_PAGO_PUBLIC_KEY}" \
                        -e MERCADO_PAGO_ACCESS_TOKEN="${MERCADO_PAGO_ACCESS_TOKEN}" \
                        -e SERVER_PORT="${APP_PORT}" \
                        -e UPLOAD_DIR=/app/uploads \
                        -v ${UPLOADS_HOST_DIR}:/app/uploads \
                        ${DOCKER_IMAGE}:${APP_VERSION}
                '''
            }
        }

        stage('Health Check') {
            steps {
                echo '=== Verificando se o Backend respondeu ao health check ==='
                sh '''
                    sleep 20
                    curl -f http://${CONTAINER_NAME}:${APP_PORT}/v3/api-docs || \
                        (echo "ERRO: Backend nao respondeu ao health check!" && exit 1)
                '''
            }
        }
    }

    post {
        success {
            echo "Pipeline do Backend concluida com sucesso! Versao: ${env.APP_VERSION} (Build #${BUILD_NUMBER})"
        }
        failure {
            echo "Pipeline do Backend FALHOU no build #${BUILD_NUMBER}."
        }
        always {
            script {
                if (getContext(hudson.FilePath)) {
                    sh 'docker image prune -f || true'
                }
            }
        }
    }
}
