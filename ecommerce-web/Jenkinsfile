// ============================================================
// Jenkinsfile — Pipeline do Frontend (React + Vite + Nginx)
// Repositório: d:\GIT\Projeto _Loja_3D\ecommerce-web
// Trigger: Manual / Push
// ============================================================
pipeline {
    agent any

    environment {
        // Docker
        DOCKER_IMAGE   = 'patrickmoura/ecommerce-web'
        CONTAINER_NAME = '3dprintpng-web'
        APP_PORT       = '3002'
    }

    stages {
        stage('Checkout') {
            steps {
                echo '=== Clonando repositorio ==='
                checkout scm
            }
        }

        stage('Extrair Versao do Frontend') {
            steps {
                echo '=== Detectando versao do Frontend a partir do package.json ==='
                dir('ecommerce-web') {
                    script {
                        def frontVer = sh(
                            script: 'node -p "require(\'./package.json\').version" 2>/dev/null || grep -m 1 "\\"version\\"" package.json | sed -E "s/.*\\"version\\": *\\"([^\\"]+)\\".*/\\1/" | tr -d " \t\r\n"',
                            returnStdout: true
                        ).trim()
                        if (!frontVer || frontVer.contains('null')) {
                            frontVer = '1.0.0'
                        }
                        env.APP_VERSION = frontVer
                        echo "Versao definida para o release do Frontend: ${env.APP_VERSION}"
                    }
                }
            }
        }

        stage('Build Vite') {
            steps {
                echo '=== Instalando dependencias e compilando o Frontend ==='
                dir('ecommerce-web') {
                    sh '''
                        npm ci --prefer-offline
                        npm run build
                    '''
                }
            }
        }

        stage('Docker Build') {
            steps {
                echo "=== Construindo imagem Docker do Frontend (Versao: ${env.APP_VERSION}, Build: #${BUILD_NUMBER}) ==="
                dir('ecommerce-web') {
                    sh '''
                        docker build \
                            -t ${DOCKER_IMAGE}:${APP_VERSION} \
                            -t ${DOCKER_IMAGE}:${APP_VERSION}-${BUILD_NUMBER} \
                            -t ${DOCKER_IMAGE}:latest \
                            .
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                echo "=== Parando container antigo e subindo novo com versao ${env.APP_VERSION} ==="
                sh '''
                    # Para e remove o container anterior (se existir)
                    docker stop ${CONTAINER_NAME} || true
                    docker rm   ${CONTAINER_NAME} || true

                    # Sobe o novo container do Frontend (Nginx na porta 3002 externa, 80 interna) conectado a rede
                    docker run \
                        --name ${CONTAINER_NAME} \
                        --network jenkins_jenkins_net \
                        --restart=always \
                        -d \
                        -p ${APP_PORT}:80 \
                        ${DOCKER_IMAGE}:${APP_VERSION}
                '''
            }
        }

        stage('Health Check') {
            steps {
                echo '=== Verificando se o Frontend esta respondendo ==='
                sh '''
                    sleep 5
                    curl -f http://${CONTAINER_NAME} || \
                        (echo "ERRO: Frontend nao respondeu!" && exit 1)
                '''
            }
        }
    }

    post {
        success {
            echo "Pipeline do Frontend concluida com sucesso! Versao: ${env.APP_VERSION} (Build #${BUILD_NUMBER})"
        }
        failure {
            echo "Pipeline do Frontend FALHOU no build #${BUILD_NUMBER}."
        }
        always {
            sh 'docker image prune -f || true'
        }
    }
}